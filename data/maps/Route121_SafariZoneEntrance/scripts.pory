script Route121_SafariZoneEntrance_EventScript_ManiacChooseVivillonForm{
	msgbox(Route121_SafariZoneEntrance_Text_WhichForm)
	waitmessage
	setvar(VAR_0x8004, SCROLL_MULTI_MANIAC_VIVILLON_FORM)
